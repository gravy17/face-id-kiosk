APP_NAME="Facial Identity Management System"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./facial_kiosk.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=15

ADMIN_API_KEY=replace-with-a-secure-admin-key

CHALLENGE_TTL_SECONDS=30

CORS_ORIGINS=["http://localhost:5173"]

VERIFICATION_THRESHOLD=0.40
LIVENESS_THRESHOLD=0.5

CLEANUP_AGE_DAYS=30
CLEANUP_INTERVAL_HOURS=24

MINIFAS_MODEL_DIR=app/services/minifas_weights

RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_VERIFY=10/minute
