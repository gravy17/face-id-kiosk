APP_NAME="Facial Identity Management System"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./facial_kiosk.db

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=15

ADMIN_API_KEY=replace-with-a-secure-admin-key

CHALLENGE_TTL_SECONDS=30

CORS_ORIGINS=["http://localhost:5173"]

ONNX_PROVIDERS = ["CPUExecutionProvider"]
DETECTION_INPUT_SIZE = 640
DETECTION_CONF_THRESHOLD = 0.5
DETECTION_NMS_THRESHOLD = 0.4
RECOGNITION_INPUT_SIZE = 112
VERIFICATION_THRESHOLD=0.40
LIVENESS_INPUT_SIZE = 80
LIVENESS_CROP_SCALE = 2.7
LIVENESS_CHANNEL_ORDER=bgr       
LIVENESS_REAL_CLASS_INDEX=1 
LIVENESS_NORMALIZE_255=false
LIVENESS_THRESHOLD=0.5

MIN_SHARPNESS_SCORE=80

CLEANUP_AGE_DAYS=30
CLEANUP_INTERVAL_HOURS=24

MODELS_DIR=models

DETECTION_MODEL_PATH=models/detection/det_500m.onnx
RECOGNITION_MODEL_PATH=models/recognition/w600k_mbf.onnx
LIVENESS_MODEL_PATH=models/liveness/MiniFASNetV2.onnx

RATE_LIMIT_REGISTER= "5/minute"
RATE_LIMIT_VERIFY= "10/minute"